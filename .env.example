# Credenciales del panel de profesor.
# Copia este archivo a `.env` y rellena los dos valores. NO subas `.env` al repositorio:
# ya está en `.gitignore`.

# Usuario del panel de profesor. Sin valor por defecto a propósito.
ADMIN_USER=

# Contraseña del panel de profesor. Usa una larga y única para esta instancia.
ADMIN_PASS=

# Puerto del servidor Express.
PORT=3000